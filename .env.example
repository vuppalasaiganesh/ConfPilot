# --- LLM (any OpenAI-compatible API) ---
# Grok (xAI):
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4
# OpenAI instead:   LLM_BASE_URL=https://api.openai.com/v1   LLM_MODEL=gpt-4o-mini
# Leave LLM_API_KEY empty to run without an LLM (rule-based reasons, still fully demoable).

# --- Elasticsearch ---
ES_URL=http://localhost:9200
ES_INDEX_TALKS=talks
ES_INDEX_PEOPLE=attendees

# --- Embeddings: fastembed (local, free, default) | openai | hash (offline fallback, low quality) ---
EMBEDDINGS=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# For EMBEDDINGS=openai:
OPENAI_EMBED_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Optional OpenTelemetry tracing ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=confpilot
