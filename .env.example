# --- LLM (any OpenAI-compatible API). Use ONE block; leave LLM_API_KEY empty to run without AI. ---
# Google Gemini (free tier, key from https://aistudio.google.com/apikey):
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.8-flash
# Backups tried automatically when the main model is busy (503), rate limited (429) or too slow:
LLM_FALLBACK_MODELS=gemini-2.5-flash-lite
#
# Groq (free tier, key from https://console.groq.com):
#   LLM_BASE_URL=https://api.groq.com/openai/v1    LLM_MODEL=llama-3.3-70b-versatile
# xAI Grok (paid, key from https://console.x.ai):
#   LLM_BASE_URL=https://api.x.ai/v1               LLM_MODEL=grok-4
# OpenAI (paid):
#   LLM_BASE_URL=https://api.openai.com/v1         LLM_MODEL=gpt-4o-mini
# If the model name is wrong, the page's status line lists the models your key can use.
# Optional: LLM_TIMEOUT=45 (seconds); LLM_REASONING_EFFORT=low keeps "thinking" models fast (empty = off).

# --- Elasticsearch ---
ES_URL=http://localhost:9200
ES_INDEX_TALKS=talks
ES_INDEX_PEOPLE=attendees

# --- Embeddings: fastembed (local, free, default) | openai | hash (offline fallback, low quality) ---
EMBEDDINGS=fastembed
FASTEMBED_MODEL=BAAI/bge-small-en-v1.5
# For EMBEDDINGS=openai:
OPENAI_EMBED_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- Optional OpenTelemetry tracing ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=confpilot
